# ============================================
# YAP - Proje Yönetimi Sistemi
# Environment Variables Konfigürasyonu
# ============================================

# ============================================
# 🏗️ TEMEL UYGULAMA AYARLARI
# ============================================

# Uygulama URL'i (Production: https://yap-next.vercel.app, Development: http://localhost:3000)
NEXT_PUBLIC_APP_URL=https://yap-next.vercel.app

# Site URL'i (Supabase Auth için - genellikle NEXT_PUBLIC_APP_URL ile aynı)
NEXT_PUBLIC_SITE_URL=https://yap-next.vercel.app

# Vercel Proje Bilgileri (MCP'den alınan)
# Proje ID: prj_tMiy6StpJ1GZAK10fKcbOi55Ziwh
# Team ID: team_J8e247l76DfwCgZSwuYDOcC0
# Production URL: https://yap-next.vercel.app
# Preview URL: https://yap-next-kaygusuzbks.vercel.app
# Git Main URL: https://yap-next-git-main-kaygusuzbks.vercel.app

# ============================================
# 🗄️ SUPABASE VERİTABANI VE AUTH
# ============================================

# Supabase Proje URL'i (Dashboard > Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Key (Dashboard > Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (Dashboard > Settings > API > service_role)
# ⚠️  DİKKAT: Bu anahtar sadece server-side kullanılmalı, asla client'a sızdırılmamalı!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase Automation User ID (Slack entegrasyonu için sistem kullanıcısı)
SUPABASE_AUTOMATION_USER_ID=your_automation_user_id

# ============================================
# 🔐 OAUTH ENTEGRASYONLARI
# ============================================

# GitHub OAuth
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth (Calendar entegrasyonu için)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================
# 🤖 AI VE YAPAY ZEKA SERVİSLERİ
# ============================================

# Google Generative AI (Gemini API)
GOOGLE_GENERATIVE_AI_API_KEY=your_google_gemini_api_key

# OpenAI API (Opsiyonel - gelecekteki entegrasyonlar için)
OPENAI_API_KEY=your_openai_api_key

# ============================================
# 📱 SLACK ENTEGRASYONU
# ============================================

# Slack Bot Token (Bot User OAuth Token)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Slack Signing Secret (Request Verification için)
SLACK_SIGNING_SECRET=your_slack_signing_secret

# Slack Default Channel (Görev bildirimleri için varsayılan kanal)
SLACK_DEFAULT_CHANNEL=general

# Slack Webhook URL (Opsiyonel - webhook bildirimleri için)
NEXT_PUBLIC_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ============================================
# 🔔 N8N WORKFLOW ENTEGRASYONU
# ============================================

# N8N Assistant Webhook URLs (Chat Widget için)
N8N_ASSISTANT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/assistant
NEXT_PUBLIC_N8N_ASSISTANT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/assistant

# Production N8N Webhook
N8N_ASSISTANT_WEBHOOK_URL_PROD=https://your-prod-n8n-instance.com/webhook/assistant
NEXT_PUBLIC_N8N_ASSISTANT_WEBHOOK_URL_PROD=https://your-prod-n8n-instance.com/webhook/assistant

# Test N8N Webhook
N8N_ASSISTANT_WEBHOOK_URL_TEST=https://your-test-n8n-instance.com/webhook/assistant
NEXT_PUBLIC_N8N_ASSISTANT_WEBHOOK_URL_TEST=https://your-test-n8n-instance.com/webhook/assistant

# ============================================
# 📧 EMAIL SERVİSLERİ
# ============================================

# Resend API (Email gönderimi için)
RESEND_API_KEY=re_your_resend_api_key

# ============================================
# 🎨 UI VE UX AYARLARI
# ============================================

# Bot Adı (Chat Widget için)
NEXT_PUBLIC_BOT_NAME=YAP_BOT

# Vercel Environment (Production/Preview/Development)
# Vercel Proje ID: prj_tMiy6StpJ1GZAK10fKcbOi55Ziwh
# Vercel Team ID: team_J8e247l76DfwCgZSwuYDOcC0
# Framework: nextjs
# Node Version: 22.x
# Live: false
NEXT_PUBLIC_VERCEL_ENV=production

# ============================================
# 🔧 MCP (Model Context Protocol) AYARLARI
# ============================================

# Supabase MCP Konfigürasyonu
SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co
SUPABASE_API_KEY=your_supabase_anon_key
MCP_SUPABASE_READ_ONLY=true

# Supabase Management API (Opsiyonel)
SUPABASE_ACCESS_TOKEN=your_supabase_access_token
SUPABASE_PROJECT_REF=your_project_ref

# ============================================
# 🚀 DEPLOYMENT VE PRODUCTION
# ============================================

# Database URL (PostgreSQL bağlantı string'i)
DATABASE_URL=postgres://postgres:password@host:5432/postgres

# Node Environment
NODE_ENV=production

# Vercel Deployment Bilgileri (MCP'den alınan)
